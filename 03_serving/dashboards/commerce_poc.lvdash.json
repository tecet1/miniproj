{
  "datasets": [
    {
      "name": "2287e411",
      "displayName": "sales_kpi",
      "queryLines": [
        "SELECT MEASURE(total_sales) AS total_sales, MEASURE(refund_amount) AS refund_amount, MEASURE(net_sales) AS net_sales, MEASURE(refund_ratio) AS refund_ratio, MEASURE(item_count) AS item_count, MEASURE(unit_price_per_item) AS unit_price_per_item, MEASURE(paying_customers) AS paying_customers, MEASURE(average_order_value) AS average_order_value FROM commerce_poc.serving.sales_metrics"
      ]
    },
    {
      "name": "08ddd66c",
      "displayName": "sales_by_date",
      "queryLines": [
        "SELECT payment_date, MEASURE(total_sales) AS total_sales, MEASURE(refund_amount) AS refund_amount, MEASURE(net_sales) AS net_sales FROM commerce_poc.serving.sales_metrics GROUP BY ALL ORDER BY payment_date"
      ]
    },
    {
      "name": "50ae0c69",
      "displayName": "sales_by_channel",
      "queryLines": [
        "SELECT channel_name, MEASURE(total_sales) AS total_sales, MEASURE(refund_amount) AS refund_amount, MEASURE(net_sales) AS net_sales, MEASURE(refund_ratio) AS refund_ratio, MEASURE(item_count) AS item_count, MEASURE(unit_price_per_item) AS unit_price_per_item, MEASURE(paying_customers) AS paying_customers, MEASURE(average_order_value) AS average_order_value FROM commerce_poc.serving.sales_metrics GROUP BY ALL ORDER BY channel_name"
      ]
    },
    {
      "name": "82ba6cf0",
      "displayName": "sales_by_method",
      "queryLines": [
        "SELECT method_name, MEASURE(total_sales) AS total_sales, MEASURE(item_count) AS item_count FROM commerce_poc.serving.sales_metrics GROUP BY ALL ORDER BY method_name"
      ]
    },
    {
      "name": "73337f11",
      "displayName": "sales_by_category",
      "queryLines": [
        "SELECT category, MEASURE(total_sales) AS total_sales, MEASURE(refund_amount) AS refund_amount, MEASURE(net_sales) AS net_sales FROM commerce_poc.serving.sales_metrics GROUP BY ALL ORDER BY category"
      ]
    },
    {
      "name": "68e4e686",
      "displayName": "refund_kpi",
      "queryLines": [
        "SELECT MEASURE(refund_amount) AS refund_amount, MEASURE(refund_quantity) AS refund_quantity FROM commerce_poc.serving.refund_metrics"
      ]
    },
    {
      "name": "e67f8ebe",
      "displayName": "refund_by_date",
      "queryLines": [
        "SELECT payment_date, MEASURE(refund_amount) AS refund_amount, MEASURE(refund_quantity) AS refund_quantity FROM commerce_poc.serving.refund_metrics GROUP BY ALL ORDER BY payment_date"
      ]
    },
    {
      "name": "62566ebc",
      "displayName": "refund_by_reason",
      "queryLines": [
        "SELECT *, CAST(refund_amount AS DOUBLE) / SUM(refund_amount) OVER () AS refund_amount_share FROM (SELECT refund_reason, MEASURE(refund_amount) AS refund_amount, MEASURE(refund_quantity) AS refund_quantity FROM commerce_poc.serving.refund_metrics GROUP BY ALL) AS base ORDER BY refund_reason"
      ]
    },
    {
      "name": "5051fcf9",
      "displayName": "refund_by_channel",
      "queryLines": [
        "SELECT channel_name, MEASURE(refund_amount) AS refund_amount, MEASURE(refund_quantity) AS refund_quantity FROM commerce_poc.serving.refund_metrics GROUP BY ALL ORDER BY channel_name"
      ]
    }
  ],
